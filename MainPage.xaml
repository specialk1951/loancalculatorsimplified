<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LoanCalculatorSimplified.MainPage"
             Title="Loan Calculator Simplified">

    <Shell.TitleView>
        <Label Text="Loan Calculator Simplified"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               VerticalTextAlignment="Center" />
    </Shell.TitleView>

    <ScrollView BackgroundColor="#C8E6F5">
        <VerticalStackLayout Padding="16,20,20,20" Spacing="15" BackgroundColor="#C8E6F5"
                             MaximumWidthRequest="500" HorizontalOptions="Center">

            <!-- Loan Amount -->
            <Grid ColumnDefinitions="2*, 0.4*, 3.12*" ColumnSpacing="10">
                <Button x:Name="btnLoanAmount"
                        Text="Loan&#10;Amount"
                        FontSize="13"
                        HeightRequest="54"
                        WidthRequest="139"
                        HorizontalOptions="Start"
                        BorderWidth="0"
                        TranslationX="-36"
                        Clicked="btnLoanAmount_Click" />
                <Entry x:Name="txbLoanAmount"
                       Placeholder="Loan Amount"
                       FontSize="18"
                       Keyboard="Numeric"
                       HeightRequest="23"
                       WidthRequest="190"
                       HorizontalOptions="Start"
                       Margin="140,0,0,0"
                       BackgroundColor="White"
                       TextChanged="Entry_TextChanged"
                       Grid.ColumnSpan="3" />
            </Grid>

            <!-- Interest Rate -->
            <Grid ColumnDefinitions="2*, 0.4*, 3.12*" ColumnSpacing="10">
                <Button x:Name="btnInterestRate"
                        Text="Interest&#10;Rate"
                        FontSize="13"
                        HeightRequest="54"
                        WidthRequest="139"
                        HorizontalOptions="Start"
                        BorderWidth="0"
                        TranslationX="-36"
                        Clicked="btnInterestRate_Click" />
                <Entry x:Name="txbInterestRate"
                       Placeholder="Interest Rate"
                       FontSize="18"
                       Keyboard="Numeric"
                       HeightRequest="23"
                       WidthRequest="190"
                       HorizontalOptions="Start"
                       Margin="140,0,0,0"
                       BackgroundColor="White"
                       TextChanged="Entry_TextChanged"
                       Grid.ColumnSpan="3" />
            </Grid>

            <!-- Number of Payments -->
            <Grid ColumnDefinitions="2*, 0.4*, 3.12*" ColumnSpacing="10">
                <Button x:Name="btnNumberOfPayments"
                        Text="Number Of&#10;Payments"
                        FontSize="13"
                        HeightRequest="54"
                        WidthRequest="139"
                        HorizontalOptions="Start"
                        BorderWidth="0"
                        TranslationX="-36"
                        Clicked="btnNumberOfPayments_Click" />
                <Entry x:Name="txbNumberOfPayments"
                       Placeholder="No. of Payments"
                       FontSize="18"
                       Keyboard="Numeric"
                       HeightRequest="23"
                       WidthRequest="190"
                       HorizontalOptions="Start"
                       Margin="140,0,0,0"
                       BackgroundColor="White"
                       TextChanged="Entry_TextChanged"
                       Grid.ColumnSpan="3" />
            </Grid>

            <!-- Payment Amount -->
            <Grid ColumnDefinitions="2*, 0.4*, 3.12*" ColumnSpacing="10">
                <Button x:Name="btnPaymentAmount"
                        Text="Payment&#10;Amount"
                        FontSize="13"
                        HeightRequest="54"
                        WidthRequest="139"
                        HorizontalOptions="Start"
                        BorderWidth="0"
                        TranslationX="-36"
                        Clicked="btnPaymentAmount_Click" />
                <Entry x:Name="txbPaymentAmount"
                       Placeholder="Payment Amount"
                       FontSize="18"
                       Keyboard="Numeric"
                       HeightRequest="23"
                       WidthRequest="190"
                       HorizontalOptions="Start"
                       Margin="140,0,0,0"
                       BackgroundColor="White"
                       TextChanged="Entry_TextChanged"
                       Grid.ColumnSpan="3" />
            </Grid>

            <!-- Total Interest -->
            <Grid ColumnDefinitions="2*, 0.4*, 3.12*" ColumnSpacing="10">
                <Label Text="Total Interest:"
                       FontSize="18"
                       VerticalOptions="Center"
                       HorizontalOptions="End"
                       Grid.Column="0"
                       Grid.ColumnSpan="2" />
                <Entry x:Name="txbTotalInterest"
                       Placeholder="Total Interest"
                       FontSize="18"
                       IsReadOnly="True"
                       HeightRequest="27"
                       WidthRequest="190"
                       HorizontalOptions="Start"
                       Margin="140,0,0,0"
                       BackgroundColor="White"
                       Grid.ColumnSpan="3" />
            </Grid>

            <!-- Clear / Info Buttons -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                <Button x:Name="btnInfo"
                        Text="Info"
                        FontSize="14"
                        HeightRequest="48"
                        BackgroundColor="White"
                        TextColor="Black"
                        TranslationX="2"
                        Grid.Column="0"
                        Clicked="btnInfo_Click" />
                <Button x:Name="btnClear"
                        Text="Clear"
                        FontSize="14"
                        HeightRequest="48"
                        BackgroundColor="White"
                        TextColor="Black"
                        TranslationX="2"
                        Grid.Column="1"
                        Clicked="btnClear_Click" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
